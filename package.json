{
  "name": "ultra-watchface",
  "author": "Eduardo Chiaro",
  "version": "2.2.0",
  "keywords": [
    "watchface",
    "complications",
    "ultra"
  ],
  "private": true,
  "scripts": {
    "build": "node scripts/inline-config.mjs && pebble clean && pebble build",
    "emulator": "npm run build && pebble install --emulator",
    "phone": "npm run build && pebble install --phone",
    "config": "pebble emu-app-config --emulator",
    "screenshot": "bash scripts/screenshot.sh",
    "logs": "pebble logs",
    "test": "node test/page.test.js",
    "font": "node scripts/gen-svg-font.js resources/fonts/Nunito-Bold.ttf resources/fonts/nunito.svg nunito \" %,-./0123456789:@ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\u00b0\u00c0\u00c1\u00c2\u00c3\u00c4\u00c5\u00c6\u00c7\u00c8\u00c9\u00ca\u00cb\u00cc\u00cd\u00ce\u00cf\u00d1\u00d2\u00d3\u00d4\u00d5\u00d6\u00d8\u00d9\u00da\u00db\u00dc\u00df\u00e0\u00e1\u00e2\u00e3\u00e4\u00e5\u00e6\u00e7\u00e8\u00e9\u00ea\u00eb\u00ec\u00ed\u00ee\u00ef\u00f1\u00f2\u00f3\u00f4\u00f5\u00f6\u00f8\u00f9\u00fa\u00fb\u00fc\u0152\u0153\" && fctx-compiler resources/fonts/nunito.svg && mv resources/nunito.ffont resources/fonts/nunito.ffont"
  },
  "pebble": {
    "displayName": "Ultra",
    "uuid": "69495bb8-66e5-43fd-a3c2-e28a0d8be949",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "basalt",
      "chalk",
      "diorite",
      "flint",
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "TEMP",
      "TEMP_MIN",
      "TEMP_MAX",
      "RAIN",
      "AQI",
      "UV",
      "HUMIDITY",
      "CONDITION",
      "ELEVATION",
      "SLOT_TL",
      "SLOT_TR",
      "SLOT_BR",
      "SLOT_BL",
      "CENTER_T",
      "CENTER_L",
      "CENTER_R",
      "CENTER_B",
      "SECONDS",
      "STEP_GOAL",
      "SCHEME",
      "BG_COLOR",
      "ACCENT_COLOR",
      "UNITS",
      "TEXT_TL",
      "TEXT_TR",
      "TEXT_BR",
      "TEXT_BL",
      "TEXT_T",
      "TEXT_L",
      "TEXT_R",
      "TEXT_B",
      "API_INDEX",
      "API_TYPE",
      "API_NAME",
      "API_TEXT",
      "API_PCT",
      "API_MIN",
      "API_MAX",
      "SUNRISE",
      "SUNSET",
      "WIND",
      "WIND_DIR",
      "HANDS",
      "HAND_COLOR",
      "SECOND_COLOR",
      "MINUTE_COLOR",
      "RING",
      "BAND_COLOR",
      "ZONE_TL",
      "ZONE_TR",
      "ZONE_BR",
      "ZONE_BL",
      "ZONE_T",
      "ZONE_L",
      "ZONE_R",
      "ZONE_B",
      "LOCATION",
      "LOCATION_CODE",
      "SWEEP",
      "SHAKE_HIDE",
      "SAVER",
      "ASLEEP",
      "RAIN_START",
      "RAIN_HOURS",
      "SQUARE",
      "LANG",
      "WEEK_START",
      "PRESSURE",
      "JOIN",
      "FEELS"
    ],
    "resources": {
      "media": [
        {
          "type": "raw",
          "name": "FONT",
          "file": "fonts/nunito.ffont"
        }
      ]
    },
    "capabilities": [
      "health",
      "configurable",
      "location"
    ]
  },
  "dependencies": {
    "pebble-fctx": "^1.6.5"
  },
  "devDependencies": {
    "opentype.js": "^2.0.0",
    "pebble-fctx-compiler": "^1.2.2",
    "svg-path-parser": "^1.1.0"
  }
}
