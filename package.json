{
  "name": "ultra-watchface",
  "author": "Eduardo Chiaro",
  "version": "1.7.0",
  "keywords": [
    "watchface",
    "complications",
    "ultra"
  ],
  "private": true,
  "scripts": {
    "build": "node scripts/inline-config.mjs && pebble clean && pebble build",
    "emulator": "npm run build && pebble install --emulator",
    "phone": "npm run build && pebble install --phone",
    "config": "pebble emu-app-config --emulator",
    "screenshot": "bash scripts/screenshot.sh",
    "logs": "pebble logs",
    "test": "node test/page.test.js",
    "font": "node scripts/gen-svg-font.js resources/fonts/Nunito-Bold.ttf resources/fonts/nunito.svg nunito \" %,-./0123456789:@ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz\u00b0\" && fctx-compiler resources/fonts/nunito.svg && mv resources/nunito.ffont resources/fonts/nunito.ffont"
  },
  "pebble": {
    "displayName": "Ultra",
    "uuid": "69495bb8-66e5-43fd-a3c2-e28a0d8be949",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": [
      "emery",
      "gabbro"
    ],
    "watchapp": {
      "watchface": true
    },
    "messageKeys": [
      "TEMP",
      "TEMP_MIN",
      "TEMP_MAX",
      "RAIN",
      "AQI",
      "UV",
      "HUMIDITY",
      "CONDITION",
      "ELEVATION",
      "SLOT_TL",
      "SLOT_TR",
      "SLOT_BR",
      "SLOT_BL",
      "CENTER_T",
      "CENTER_L",
      "CENTER_R",
      "CENTER_B",
      "SECONDS",
      "STEP_GOAL",
      "SCHEME",
      "BG_COLOR",
      "ACCENT_COLOR",
      "UNITS",
      "TEXT_TL",
      "TEXT_TR",
      "TEXT_BR",
      "TEXT_BL",
      "TEXT_T",
      "TEXT_L",
      "TEXT_R",
      "TEXT_B",
      "API_INDEX",
      "API_TYPE",
      "API_NAME",
      "API_TEXT",
      "API_PCT",
      "API_MIN",
      "API_MAX",
      "SUNRISE",
      "SUNSET",
      "WIND",
      "WIND_DIR",
      "HANDS",
      "HAND_COLOR",
      "SECOND_COLOR",
      "MINUTE_COLOR",
      "RING",
      "BAND_COLOR",
      "ZONE_TL",
      "ZONE_TR",
      "ZONE_BR",
      "ZONE_BL",
      "ZONE_T",
      "ZONE_L",
      "ZONE_R",
      "ZONE_B",
      "LOCATION",
      "LOCATION_CODE",
      "SWEEP",
      "SHAKE_HIDE",
      "SAVER",
      "ASLEEP"
    ],
    "resources": {
      "media": [
        {
          "type": "raw",
          "name": "FONT",
          "file": "fonts/nunito.ffont"
        }
      ]
    },
    "capabilities": [
      "health",
      "configurable",
      "location"
    ]
  },
  "dependencies": {
    "pebble-fctx": "^1.6.5"
  },
  "devDependencies": {
    "opentype.js": "^2.0.0",
    "pebble-fctx-compiler": "^1.2.2",
    "svg-path-parser": "^1.0.1"
  }
}
